  0.7622\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 2000x400 with 10 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["import matplotlib.pyplot as plt\n","import seaborn as sns\n","from sklearn.metrics import accuracy_score, f1_score, confusion_matrix\n","from src.config import LABELS\n","\n","def compute_metrics(df, pred_col):\n","    acc = accuracy_score(df[LABEL_COL], df[pred_col])\n","    f1  = f1_score(df[LABEL_COL], df[pred_col], average='macro', zero_division=0)\n","    return round(acc, 4), round(f1, 4)\n","\n","def plot_cm(ax, df, pred_col, title):\n","    cm = confusion_matrix(df[LABEL_COL], df[pred_col], labels=LABELS)\n","    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\n","                xticklabels=LABELS, yticklabels=LABELS, ax=ax)\n","    ax.set_title(title, fontsize=9)\n","    ax.set_xlabel('Predicted')\n","    ax.set_ylabel('True')\n","\n","dev_strategies = [\n","    ('FinBERT (baseline)',   df_dev,     FINBERT_COL),\n","    ('Single Prompt',        df_dev_sp,  'final_prediction'),\n","    ('Multi-hop',            df_dev_mh,  'final_prediction'),\n","    ('Hybrid',               df_dev_hy,  'final_prediction'),\n","    ('Hybrid RAG',           df_dev_rag, 'final_prediction'),\n","]\n","\n","rows = []\n","for name, df_, pred_col in dev_strategies:\n","    acc, f1 = compute_metrics(df_, pred_col)\n","    rows.append({'Strategy': name, 'Dev Accuracy': acc, 'Dev Macro F1': f1})\n","\n","dev_summary = pd.DataFrame(rows)\n","print('=== Dev Set Summary ===')\n","print(dev_summary.to_string(index=False))\n","\n","# Confusion matrices\n","fig, axes = plt.subplots(1, len(dev_strategies), figsize=(4*len(dev_strategies), 4))\n","for i, (name, df_, pred_col) in enumerate(dev_strategies):\n","    plot_cm(axes[i], df_, pred_col, f'{name} — Dev')\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","metadata":{"id":"0ByejAmuGEwK"},"source":["## 9. Test Set Evaluation\n"]},{"cell_type":"code","execution_count":15,"m