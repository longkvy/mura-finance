     0.7184        0.7117         0.7100         0.6977\n","         Multi-hop        0.7392        0.7396         0.7641         0.7616\n","            Hybrid        0.7600        0.7612         0.7706         0.7686\n","        Hybrid RAG        0.7611        0.7622         0.7684         0.7669\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x2000 with 20 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["all_strategies = [\n","    ('FinBERT (baseline)', df_dev,     df_test,     FINBERT_COL),\n","    ('Single Prompt',      df_dev_sp,  df_test_sp,  'final_prediction'),\n","    ('Multi-hop',          df_dev_mh,  df_test_mh,  'final_prediction'),\n","    ('Hybrid',             df_dev_hy,  df_test_hy,  'final_prediction'),\n","    ('Hybrid RAG',         df_dev_rag, df_test_rag, 'final_prediction'),\n","]\n","\n","rows = []\n","for name, dev_df, test_df, pred_col in all_strategies:\n","    dev_acc,  dev_f1  = compute_metrics(dev_df,  pred_col)\n","    test_acc, test_f1 = compute_metrics(test_df, pred_col)\n","    rows.append({\n","        'Strategy':      name,\n","        'Dev Accuracy':  dev_acc,\n","        'Dev Macro F1':  dev_f1,\n","        'Test Accuracy': test_acc,\n","        'Test Macro F1': test_f1,\n","    })\n","\n","final_summary = pd.DataFrame(rows)\n","print('=== Final Comparison — Dev & Test ===')\n","print(final_summary.to_string(index=False))\n","final_summary.to_csv('data/finance/comparison_flan_xxl.csv', index=False)\n","\n","# Confusion matrices — Dev & Test side by side\n","fig, axes = plt.subplots(\n","    nrows=len(all_strategies), ncols=2,\n","    figsize=(10, 4 * len(all_strategies))\n",")\n","for i, (name, dev_df, test_df, pred_col) in enumerate(all_strategies):\n","    plot_cm(axes[i, 0], dev_df,  pred_col, f'{name} — Dev')\n","    plot_cm(axes[i, 1], test_df, pred_col, f'{name} — Test')\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","metadata":{"id":"PIJ0FtK7GEwK"},"source":["## 11. Save All 